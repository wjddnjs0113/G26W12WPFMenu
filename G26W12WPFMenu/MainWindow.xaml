<Window x:Class="G26W12WPFMenu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:G26W12WPFMenu"
        mc:Ignorable="d"
        Title="배경색 지정" Height="350" Width="525">
    <DockPanel>
        <Menu DockPanel.Dock="Top" IsMainMenu="True">
            <MenuItem Header="파일(_F)">
                <MenuItem Header="새로 만들기(_N)">
                    <MenuItem Header="프로젝트(_P)"/>
                    <MenuItem Header="파일(_F)"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="배경색(_B)">
                <MenuItem Header="빨간색(_R)"
                      Command="{Binding SetColorCommand}"
                      CommandParameter="Red"
                      IsChecked="{Binding IsRedSelected, Mode=OneWay}"/>
                <MenuItem Header="녹색(_G)"
                      Command="{Binding SetColorCommand}"
                      CommandParameter="Green"
                      IsChecked="{Binding IsGreenSelected, Mode=OneWay}"/>
                <MenuItem Header="파란색(_B)"
                      Command="{Binding SetColorCommand}"
                      CommandParameter="Blue"
                      IsChecked="{Binding IsBlueSelected, Mode=OneWay}"/>
                <Separator/>
                <MenuItem Header="흰색(_W)"
                      Command="{Binding SetColorCommand}"
                      CommandParameter="White"
                      IsChecked="{Binding IsWhiteSelected, Mode=OneWay}"/>
            </MenuItem>
        </Menu>
        <Border Background="{Binding BackgroundBrush}"/>
    </DockPanel>
</Window>